<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sistema Taller - Recepción</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen p-4 font-sans">

  <!-- Contenedor principal de la App -->
  <div id="app-principal" class="max-w-md mx-auto">
    <!-- Encabezado -->
    <header class="flex justify-between items-center pb-4 border-b border-slate-700 mb-6">
      <h1 class="text-xl font-bold text-blue-400 flex items-center gap-2">
        <i class="fa-solid fa-wrench"></i> Control de Taller
      </h1>
      <button onclick="verLista()" class="bg-slate-800 text-xs text-blue-300 px-3 py-2 rounded-xl border border-slate-700">
        <i class="fa-solid fa-list"></i> Ver Órdenes (<span id="cant-ordenes">0</span>)
      </button>
    </header>

    <main>
      <!-- VISTA FORMULARIO -->
      <div id="vista-formulario" class="space-y-4">
        <div class="space-y-4">
          
          <!-- Cliente -->
          <div class="bg-slate-800 p-4 rounded-2xl border border-slate-700 space-y-3">
            <h2 class="text-sm font-semibold text-blue-400">1. Datos del Cliente</h2>
            <input type="text" id="cli-id" placeholder="Cédula / RIF" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-sm text-white">
            <input type="text" id="cli-nombre" placeholder="Nombre y Apellido" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-sm text-white">
            <input type="tel" id="cli-tel" placeholder="Teléfono (Ej: 04121234567)" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-sm text-white">
          </div>

          <!-- Equipo -->
          <div class="bg-slate-800 p-4 rounded-2xl border border-slate-700 space-y-3">
            <h2 class="text-sm font-semibold text-blue-400">2. Datos del Equipo y Servicio</h2>
            
            <div class="grid grid-cols-3 gap-2" id="grid-tipos">
              <button type="button" onclick="setTipo('Celular')" class="btn-t bg-blue-600 text-white p-2 rounded-xl text-xs font-bold">Celular</button>
              <button type="button" onclick="setTipo('Laptop')" class="btn-t bg-slate-700 text-slate-300 p-2 rounded-xl text-xs font-bold">Laptop</button>
              <button type="button" onclick="setTipo('PC')" class="btn-t bg-slate-700 text-slate-300 p-2 rounded-xl text-xs font-bold">PC</button>
              <button type="button" onclick="setTipo('Consola')" class="btn-t bg-slate-700 text-slate-300 p-2 rounded-xl text-xs font-bold">Consola</button>
              <button type="button" onclick="setTipo('Impresora')" class="btn-t bg-slate-700 text-slate-300 p-2 rounded-xl text-xs font-bold">Impresora</button>
              <button type="button" onclick="setTipo('Otro')" class="btn-t bg-slate-700 text-slate-300 p-2 rounded-xl text-xs font-bold">Otro</button>
            </div>

            <input type="text" id="eq-modelo" placeholder="Marca y Modelo (Ej: Infinix Hot)" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-sm text-white">
            <input type="text" id="eq-servicio" placeholder="Servicio a realizar (Ej: Cambio de pantalla)" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-sm text-white">
            <input type="text" id="eq-clave" placeholder="Clave / Patrón de Desbloqueo" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-sm text-white">
            <textarea id="eq-obs" placeholder="Observaciones físicas / Rayones..." rows="2" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-sm text-white"></textarea>
          </div>

          <!-- Cobro -->
          <div class="bg-slate-800 p-4 rounded-2xl border border-slate-700 space-y-3">
            <h2 class="text-sm font-semibold text-blue-400">3. Presupuesto</h2>
            <div class="grid grid-cols-2 gap-2">
              <input type="number" id="monto-total" step="0.01" placeholder="Monto Total ($)" class="bg-slate-900 border border-slate-700 rounded-xl p-3 text-sm text-white">
              <input type="number" id="monto-abono" step="0.01" placeholder="Abono ($)" class="bg-slate-900 border border-slate-700 rounded-xl p-3 text-sm text-white">
            </div>
          </div>

          <button type="button" onclick="guardarOrden()" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-4 rounded-2xl text-base shadow-lg shadow-blue-600/30">
            Guardar y Generar Orden
          </button>
        </div>
      </div>

      <!-- VISTA LISTA DE ÓRDENES -->
      <div id="vista-lista" class="hidden space-y-3">
        <button onclick="verFormulario()" class="w-full bg-slate-800 text-slate-300 p-3 rounded-xl border border-slate-700 text-xs font-bold">
          ← Volver al Formulario
        </button>
        <div id="contenedor-ordenes" class="space-y-3"></div>
      </div>
    </main>
  </div>

  <!-- MODAL DE ACCIONES POST-GUARDADO -->
  <div id="modal-acciones" class="fixed inset-0 bg-black/85 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-slate-800 border border-slate-700 rounded-2xl p-5 max-w-xs w-full space-y-3 text-center">
      <i class="fa-solid fa-circle-check text-emerald-400 text-4xl"></i>
      <h3 class="text-lg font-bold text-slate-100">¡Orden Guardada!</h3>
      <p class="text-xs text-slate-400" id="txt-num-orden"></p>
      
      <div class="space-y-2 pt-2">
        <button onclick="enviarWhatsApp()" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white p-3 rounded-xl font-bold text-sm flex items-center justify-center gap-2">
          <i class="fa-brands fa-whatsapp text-lg"></i> Enviar por WhatsApp
        </button>
        <button onclick="imprimirCarta()" class="w-full bg-blue-600 hover:bg-blue-500 text-white p-3 rounded-xl font-bold text-sm flex items-center justify-center gap-2">
          <i class="fa-solid fa-print"></i> Hoja Carta / Guardar PDF
        </button>
      </div>

      <button onclick="cerrarModal()" class="w-full bg-slate-900 text-slate-400 p-2 rounded-xl text-xs mt-3">Cerrar y Nueva Orden</button>
    </div>
  </div>

  <!-- SECCIÓN EXCLUSIVA PARA IMPRESIÓN (LIMPIA Y BLANCA) -->
  <div id="seccion-impresion" style="display:none; background: #ffffff; color: #000000; width: 100%;"></div>

  <script>
    let tipoActual = 'Celular';
    let ordenActiva = null;
    let ordenes = JSON.parse(localStorage.getItem('taller_ordenes') || '[]');

    actualizarContador();

    function setTipo(tipo) {
      tipoActual = tipo;
      document.querySelectorAll('.btn-t').forEach(b => {
        b.classList.remove('bg-blue-600', 'text-white');
        b.classList.add('bg-slate-700', 'text-slate-300');
      });
      event.target.classList.add('bg-blue-600', 'text-white');
      event.target.classList.remove('bg-slate-700', 'text-slate-300');
    }

    function guardarOrden() {
      const num = 'ORD-' + Math.floor(100000 + Math.random() * 900000);
      ordenActiva = {
        id: num,
        fecha: new Date().toLocaleDateString(),
        cliente: {
          id: document.getElementById('cli-id').value || 'S/N',
          nombre: document.getElementById('cli-nombre').value || 'Cliente',
          tel: document.getElementById('cli-tel').value || 'S/N'
        },
        equipo: {
          tipo: tipoActual,
          modelo: document.getElementById('eq-modelo').value || 'Genérico',
          servicio: document.getElementById('eq-servicio').value || 'Revisión',
          clave: document.getElementById('eq-clave').value || 'N/A',
          obs: document.getElementById('eq-obs').value || 'Ninguna'
        },
        costos: {
          total: parseFloat(document.getElementById('monto-total').value || 0).toFixed(2),
          abono: parseFloat(document.getElementById('monto-abono').value || 0).toFixed(2)
        }
      };

      ordenes.unshift(ordenActiva);
      localStorage.setItem('taller_ordenes', JSON.stringify(ordenes));
      actualizarContador();

      document.getElementById('txt-num-orden').innerText = `Folio: ${ordenActiva.id}`;
      document.getElementById('modal-acciones').classList.remove('hidden');
    }

    function actualizarContador() {
      document.getElementById('cant-ordenes').innerText = ordenes.length;
    }

    function enviarWhatsApp() {
      if(!ordenActiva) return;
      let tel = ordenActiva.cliente.tel.replace(/\D/g, '');
      if(tel.startsWith('0')) tel = '58' + tel.substring(1);
      
      const texto = `*GALEX IMPORT - SERVICIO TÉCNICO*\n` +
                    `*Orden:* ${ordenActiva.id}\n` +
                    `*Cliente:* ${ordenActiva.cliente.nombre}\n` +
                    `*Servicio:* ${ordenActiva.equipo.servicio} (${ordenActiva.equipo.modelo})\n` +
                    `*Total:* $${ordenActiva.costos.total} | *Abono:* $${ordenActiva.costos.abono}`;

      // Método compatible con iPhone (Safari)
      const url = `https://wa.me/${tel}?text=${encodeURIComponent(texto)}`;
      window.location.href = url;
    }

    function imprimirCarta() {
      if(!ordenActiva) return;
      
      const appPrincipal = document.getElementById('app-principal');
      const modalAcciones = document.getElementById('modal-acciones');
      const sec = document.getElementById('seccion-impresion');

      // 1. Ocultar la app y el modal en pantalla para evitar fondos oscuros en iPhone
      appPrincipal.style.display = 'none';
      modalAcciones.classList.add('hidden');

      // 2. Cargar el formato limpio en la sección de impresión
      sec.style.display = 'block';
      sec.innerHTML = `
        <div style="font-family: Arial, sans-serif; padding: 20px; color: #000000; background: #ffffff; width: 100%; box-sizing: border-box; font-size: 11px;">
          
          <!-- Encabezado -->
          <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #000; padding-bottom: 5px; margin-bottom: 10px;">
            <h2 style="margin: 0; font-size: 16px; background: #000; color: #fff; padding: 4px 15px; display: inline-block;">SERVICIO TÉCNICO</h2>
            <div style="font-size: 12px; font-weight: bold;">Fecha de emisión: ${ordenActiva.fecha} &nbsp; [${ordenActiva.id}]</div>
          </div>

          <!-- Información del Cliente -->
          <div style="background: #333; color: #fff; font-weight: bold; padding: 3px 8px; margin-bottom: 5px; font-size: 11px; text-align: center; text-transform: uppercase;">INFORMACIÓN DEL CLIENTE</div>
          <table style="width: 100%; margin-bottom: 8px; border-collapse: collapse;">
            <tr>
              <td style="padding: 3px 0;"><strong>Nombre y Apellido:</strong> ${ordenActiva.cliente.nombre}</td>
              <td style="padding: 3px 0;"><strong>Cédula:</strong> ${ordenActiva.cliente.id}</td>
            </tr>
            <tr>
              <td colspan="2" style="padding: 3px 0;"><strong>Teléfono:</strong> ${ordenActiva.cliente.tel}</td>
            </tr>
          </table>

          <!-- Información del Equipo -->
          <div style="background: #333; color: #fff; font-weight: bold; padding: 3px 8px; margin-bottom: 5px; font-size: 11px; text-align: center; text-transform: uppercase;">INFORMACIÓN DEL EQUIPO</div>
          <table style="width: 100%; margin-bottom: 8px; border-collapse: collapse;">
            <tr>
              <td style="padding: 3px 0; width: 60%;"><strong>Modelo:</strong> ${ordenActiva.equipo.modelo}</td>
              <td style="padding: 3px 0;"><strong>IMEI / Serial:</strong> ____________________</td>
            </tr>
            <tr>
              <td colspan="2" style="padding: 3px 0;"><strong>Servicio:</strong> ${ordenActiva.equipo.servicio}</td>
            </tr>
            <tr>
              <td colspan="2" style="padding: 3px 0;"><strong>Observación:</strong> ${ordenActiva.equipo.obs}</td>
            </tr>
            <tr>
              <td colspan="2" style="padding: 5px 0;">
                <strong>Método de Pago:</strong> 
                [&nbsp;&nbsp;] Efectivo &nbsp;&nbsp; 
                [&nbsp;&nbsp;] Bolívares &nbsp;&nbsp; 
                [&nbsp;&nbsp;] Punto de Venta &nbsp;&nbsp; 
                [&nbsp;&nbsp;] Pago Móvil &nbsp;&nbsp; 
                [&nbsp;&nbsp;] Binance
              </td>
            </tr>
            <tr>
              <td colspan="2" style="padding: 3px 0;"><strong>Monto:</strong> Total: $${ordenActiva.costos.total} | Abono: $${ordenActiva.costos.abono}</td>
            </tr>
          </table>

          <!-- Términos y Condiciones -->
          <div style="background: #333; color: #fff; font-weight: bold; padding: 3px 8px; margin-bottom: 5px; font-size: 11px; text-align: center; text-transform: uppercase;">TÉRMINOS Y CONDICIONES DE LA GARANTÍA</div>
          <ol style="margin: 0 0 10px 15px; padding: 0; line-height: 1.3; font-size: 9.5px;">
            <li><strong>Galex Import</strong> ofrece a sus clientes garantía de 15 días solo por repuestos que hayan sido suministrados por la empresa (pantallas, conectores de carga, baterías, etc.).</li>
            <li>La empresa no se hace responsable por dispositivos no retirados al transcurrir 30 días de su fecha de recepción.</li>
            <li>Las garantías pueden atenderse de martes a viernes desde las 10am a 3pm.</li>
            <li>La empresa no se hace responsable por pérdida de tarjeta SIM, tarjeta de memoria, bandeja SIM, etc. Serán entregados al cliente antes de ingresar al laboratorio.</li>
            <li>La empresa NO se hace responsable por fallas externas a las reparadas.</li>
            <li>Los conectores de carga se entregan reparados y probados. No tiene garantía por mala manipulación del cliente.</li>
            <li>Daños por líquidos/humedad no están cubiertos por la garantía del trabajo realizado.</li>
            <li>Las pantallas únicamente tienen garantía por falla de táctil. Pantallas maltratadas con manchas, rayas, humedad pierden la garantía automáticamente.</li>
            <li>Para la garantía el equipo pasará por una revisión de 3 a 7 días hábiles.</li>
            <li><strong>NO ACEPTAMOS DEVOLUCIONES</strong></li>
          </ol>

          <!-- Firmas y Contraseña -->
          <table style="width: 100%; margin-top: 15px; border-collapse: collapse;">
            <tr>
              <td style="width: 55%; vertical-align: bottom;">
                <p style="margin: 0 0 25px 0;">Acepto las condiciones establecidas: ______________________</p>
                <p style="margin: 0 0 5px 0;">Firma del cliente:</p>
                <div style="border-bottom: 1px solid #000; width: 200px; height: 30px;"></div>
                <br>
                <p style="margin: 0;">Vendedor: ____________________</p>
              </td>
              <td style="width: 45%; text-align: center; vertical-align: top;">
                <p style="margin: 0 0 5px 0; text-align: left;">Contraseña:</p>
                <div style="border: 1px solid #000; width: 140px; height: 30px; margin-bottom: 10px;"></div>
                <!-- Cuadro Patrón -->
                <div style="border: 1px solid #000; width: 110px; height: 110px; margin: 0 auto; display: flex; flex-direction: column; justify-content: space-around; align-items: center; padding: 5px;">
                  <div style="display:flex; gap:12px;"><span style="font-size:14px;">•</span><span style="font-size:14px;">•</span><span style="font-size:14px;">•</span></div>
                  <div style="display:flex; gap:12px;"><span style="font-size:14px;">•</span><span style="font-size:14px;">•</span><span style="font-size:14px;">•</span></div>
                  <div style="display:flex; gap:12px;"><span style="font-size:14px;">•</span><span style="font-size:14px;">•</span><span style="font-size:14px;">•</span></div>
                </div>
                <p style="margin: 5px 0 0 0; font-size: 10px;">Huella derecha</p>
              </td>
            </tr>
          </table>

        </div>
      `;

      // 3. Imprimir y restaurar la pantalla automáticamente
      setTimeout(() => {
        window.print();
        sec.style.display = 'none';
        appPrincipal.style.display = 'block';
      }, 300);
    }

    function cerrarModal() {
      document.getElementById('modal-acciones').classList.add('hidden');
      document.getElementById('cli-id').value = '';
      document.getElementById('cli-nombre').value = '';
      document.getElementById('cli-tel').value = '';
      document.getElementById('eq-modelo').value = '';
      document.getElementById('eq-servicio').value = '';
      document.getElementById('eq-clave').value = '';
      document.getElementById('eq-obs').value = '';
      document.getElementById('monto-total').value = '';
      document.getElementById('monto-abono').value = '';
    }

    function verLista() {
      document.getElementById('vista-formulario').classList.add('hidden');
      document.getElementById('vista-lista').classList.remove('hidden');
      
      const cont = document.getElementById('contenedor-ordenes');
      cont.innerHTML = '';

      if(ordenes.length === 0) {
        cont.innerHTML = '<p class="text-xs text-slate-500 text-center py-4">No hay órdenes registradas.</p>';
        return;
      }

      ordenes.forEach(o => {
        cont.innerHTML += `
          <div class="bg-slate-800 p-3 rounded-xl border border-slate-700 text-xs space-y-1">
            <div class="flex justify-between text-blue-400 font-bold">
              <span>${o.id}</span>
              <span>${o.fecha}</span>
            </div>
            <p class="text-slate-200"><strong>${o.cliente.nombre}</strong> (${o.equipo.modelo})</p>
            <p class="text-slate-400">Servicio: ${o.equipo.servicio}</p>
          </div>
        `;
      });
    }

    function verFormulario() {
      document.getElementById('vista-lista').classList.add('hidden');
      document.getElementById('vista-formulario').classList.remove('hidden');
    }
  </script>
</body>
</html>
